{
  "buildCommand": "npx turbo build --filter=@cardeko/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cardeko.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
