{
  "name": "@cardeko/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "dev:nodemon": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "seed": "ts-node-dev --transpile-only --exit-child --no-notify src/db/seed.ts",
    "backfill:images": "node scripts/backfill-images.mjs"
  },
  "dependencies": {
    "@cardeko/types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cardeko/eslint-config": "*",
    "@cardeko/prettier-config": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "prettier": "@cardeko/prettier-config"
}
