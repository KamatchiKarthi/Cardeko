NODE_ENV=development
PORT=3001

# Use direct URI (not +srv) — avoids Node.js c-ares DNS SRV lookup issues on some networks.
# Get shard hostnames from: Atlas Dashboard → Connect → Drivers → copy connection string
# then replace mongodb+srv:// with mongodb:// and add all 3 shard hosts explicitly.
#
# Format:
# mongodb://<user>:<pass>@<shard-00>:27017,<shard-01>:27017,<shard-02>:27017/<db>?replicaSet=<name>&authSource=admin&retryWrites=true&w=majority&tls=true
MONGODB_URI=mongodb://<user>:<password>@shard-00-00.xxxxx.mongodb.net:27017,shard-00-01.xxxxx.mongodb.net:27017,shard-00-02.xxxxx.mongodb.net:27017/cardeko?replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority&tls=true

CORS_ORIGIN=http://localhost:3000

# Optional — base URL for car image paths (slug appended per car)
# CAR_IMAGE_CDN_BASE=https://cdn.cardeko.in/cars
