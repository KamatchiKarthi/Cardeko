# ── Vite Frontend Environment ─────────────────────────────────────────────────
# Copy this file to .env and fill in values.
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the browser.
# Never put secrets here — this is bundled into the client.

# API base URL (only needed for production; dev uses the Vite proxy → apps/server)
# VITE_API_BASE_URL=https://api.cardeko.in

# App metadata
VITE_APP_NAME=CarDeko
VITE_APP_ENV=development
